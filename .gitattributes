* text=auto
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.ico binary

# Report checks store byte hashes; preserve the verified document bundle on clone.
docs/assignment/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Keep the bundled third-party license verbatim.
web/fonts/OFL.txt -whitespace
