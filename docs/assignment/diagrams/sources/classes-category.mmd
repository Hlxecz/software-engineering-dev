 +savedDirectory(id, meta)
 +regular(file)
 }
class JobRepository {
 -Workspace workspace
 +create(id, initial)
 +save(id, value)
 +read(id)
 +saveMeta(id, patch)
 +upload(id, value)
 +readImage(id, value)
 }
class DraftRepository {
 -Workspace workspace
 -JobRepository jobs
 +save(id, value)
 }
class PromptService {
 -Workspace workspace
 +state(blog)
 +save(blog, value)
 +resolve(blog, category)
 }

 CategoryService --> Workspace
